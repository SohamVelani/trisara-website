# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must NEVER be committed to version control.

# MongoDB connection string (required)
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trisara?retryWrites=true&w=majority
